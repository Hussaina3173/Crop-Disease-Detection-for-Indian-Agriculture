# --- Database ---
DATABASE_URL=postgresql://agriscan_user:agriscan_pass@localhost:5432/agriscan

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15

# --- Storage ---
# "local" saves to the /uploads folder. Switch to "s3" once you wire up cloud storage.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1

# --- Email (for password reset) ---
# Leave SMTP_HOST empty to just print reset links to the console during development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@agriscan.app

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5500
